# Non-secret settings only — podman env-file syntax: literal KEY=value,
# no export, quotes or interpolation. Create the real file outside the
# repository, mode 0600.
#
# Credentials never appear here: each *_API_KEY the API needs is a podman
# shell secret (named for the env var, e.g. HINDSIGHT_API_LLM_API_KEY)
# whose lookup runs `pass-keys get goblin-dev NAME` at container start.
# The database has no password — API and Postgres share one pod and the
# database listens on the pod's loopback only, which pg_hba trusts.
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight@127.0.0.1:5432/hindsight
# Model IDs/endpoints below are examples, not locks or guard defaults.
# Select zai/openai/openrouter LLM; provider/base URL/model are required,
# the API key is NOT here — it is the podman secret above.
HINDSIGHT_API_LLM_PROVIDER=zai
HINDSIGHT_API_LLM_BASE_URL=https://api.z.ai/api/paas/v4
HINDSIGHT_API_LLM_MODEL=glm-5.3-flash
# openrouter explicitly selects the fixed https://openrouter.ai/api/v1 endpoint.
# For openai instead, REMOVE the OPENROUTER field and supply:
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=<your-model>
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=<your-endpoint>
# For a LOCAL endpoint (loopback or the goblin embed relay), also set
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=local-ollama — the documented
# sentinel; ollama ignores credentials. Any other openai key is a podman
# secret, not a file value.
# Optional for asymmetric embedders (verbatim, whitespace is significant —
# embeddinggemma's query prefix ends in a space): for either provider,
# HINDSIGHT_API_EMBEDDINGS_QUERY_PREFIX=<query prefix>
# HINDSIGHT_API_EMBEDDINGS_PASSAGE_PREFIX=<passage prefix>
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openrouter
HINDSIGHT_API_EMBEDDINGS_OPENROUTER_MODEL=voyageai/voyage-4-lite
# REQUIRED decision: explicitly set rrf for verified model-free fusion ordering.
# Blank fails before Hindsight starts. No default model or automatic fallback.
HINDSIGHT_API_RERANKER_PROVIDER=
