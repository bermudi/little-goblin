# Podman env-file syntax: literal KEY=value, no export, quotes or interpolation.
# Create the real file outside the repository, mode 0600.
# Percent-encode password characters in the URI; match postgres.env.
HINDSIGHT_API_DATABASE_URL=
# Model IDs/endpoints below are examples, not locks or guard defaults.
# Select zai/openai/openrouter LLM; all four LLM fields are required.
HINDSIGHT_API_LLM_PROVIDER=zai
HINDSIGHT_API_LLM_BASE_URL=https://api.z.ai/api/paas/v4
HINDSIGHT_API_LLM_MODEL=glm-5.3-flash
HINDSIGHT_API_LLM_API_KEY=
# openrouter explicitly selects the fixed https://openrouter.ai/api/v1 endpoint.
# For openai instead, REMOVE OPENROUTER fields and supply all three:
# HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=<your-model>
# HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=<your-key>
# HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=<your-endpoint>
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openrouter
HINDSIGHT_API_EMBEDDINGS_OPENROUTER_MODEL=voyageai/voyage-4-lite
HINDSIGHT_API_EMBEDDINGS_OPENROUTER_API_KEY=
# REQUIRED decision: explicitly set rrf for verified model-free fusion ordering.
# Blank fails before Hindsight starts. No default model or automatic fallback.
HINDSIGHT_API_RERANKER_PROVIDER=
