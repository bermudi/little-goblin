{
	"name": "goblin",
	"version": "0.2.0",
	"private": true,
	"description": "Telegram-native personal AI goblin. One operator, one Bun process.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"app:build": "vite build app",
		"app:dev": "vite app",
		"doctor": "bun --no-install run src/doctor.ts"
	},
	"dependencies": {
		"@ai-sdk/openai": "4.0.95",
		"@ai-sdk/openai-compatible": "^3.0.70",
		"@ai-sdk/provider-utils": "5",
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-codemode": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@mozilla/readability": "^0.6.0",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"ai": "^7.0.142",
		"cron-parser": "^5.10.2",
		"grammy": "^1.46.0",
		"highlight.js": "^11.12.0",
		"json5": "^2.2.3",
		"linkedom": "^0.18.13",
		"mcporter": "0.15.0",
		"typebox": "1.3.37",
		"ws": "8.22.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "4.0.28",
		"@ai-sdk/react": "4.0.146",
		"@biomejs/biome": "^2.5.15",
		"@milkdown/kit": "7.22.3",
		"@types/bun": "latest",
		"@types/json5": "^2.2.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"happy-dom": "^21.0.3",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^7.0.2",
		"vite": "8.3.4"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
}
