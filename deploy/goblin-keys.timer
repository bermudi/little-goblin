[Unit]
Description=Goblin keys refresh — twice-daily warm of the goblin pass-keys cache
# Same cadence as pass-keys@pi.timer: the tmpfs cache dies with the box
# and stamps age out after 24h, so 06:30/18:30 keeps resolves off the
# login path. Persistent covers a box that was off at the scheduled time.

[Timer]
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 18:30:00
Persistent=true

[Install]
WantedBy=timers.target
