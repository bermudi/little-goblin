[Unit]
Description=Goblin v2 — Telegram-native personal agent
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/daniel/build/goblin-v2
Environment=GOBLIN_HOME=/home/daniel/goblin
# Auth commands (auth.jsonl "!cmd" records) resolve under THIS process's
# PATH — not the login shell's. The systemd user manager's default PATH is
# /usr/local/sbin:/usr/local/bin:/usr/bin only, which misses operator tools
# in the home dir (pass-cli lives in ~/bin) — every resolve would exit 127.
# Keep this list covering every tool the auth records call — and ffmpeg
# (/usr/bin), which the transcription segment path shells out to.
Environment=PATH=/home/daniel/bin:/home/daniel/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/bun run src/index.ts
# SIGTERM rides the app's own graceful shutdown (fence lanes, drain intake).
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5
# Never give up restarting — a phone-only operator can't run systemctl reset-failed.
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
