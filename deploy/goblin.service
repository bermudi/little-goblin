[Unit]
Description=Goblin v2 — Telegram-native personal agent
# network-online.target is a *system* unit — the user manager shows it
# not-found, so ordering against it silently never applied, and every boot
# paid repeated Telegram connect timeouts while the link came up. Podman's
# user wait stub is the user-manager stand-in for system network-online
# (TimeoutStartSec=90s bounds the wait; on failure Wants= — not Requires= —
# still starts us). Where the stub is absent (no podman) both lines are
# skipped: the sandbox tool degrades, not the bot.
Wants=podman-user-wait-network-online.service
After=podman-user-wait-network-online.service
# Delegation rides a sibling herdr session (DESIGN.md, "Delegation") —
# weak dep: goblin still boots when the unit is absent; the delegate
# tool is what degrades, not the bot.
Wants=goblin-herdr.service
After=goblin-herdr.service
# Start background key sync without waiting for Pass. Auth reads only
# local snapshots; a missing snapshot or locked wallet fails loud.
Wants=goblin-keys.service
# Never give up restarting — a phone-only operator can't run systemctl reset-failed.
# ([Unit], not [Service]: systemd ignores it in [Service] with an
# "Unknown key" warning — the intent silently never applied.)
StartLimitIntervalSec=0

[Service]
Type=simple
# Fresh installs run from the checkout. A box on the release layout runs from
# ~/goblin-releases/live instead: one line, rewritten once by
# `bun scripts/release.ts --adopt-unit` (design/deploy.md) — later releases
# are a symlink flip, so this never changes again.
WorkingDirectory=/home/daniel/build/little-goblin
Environment=GOBLIN_HOME=/home/daniel/goblin
# Auth commands (auth.jsonl "!cmd" records) resolve under THIS process's
# PATH — not the login shell's. The systemd user manager's default PATH is
# /usr/local/sbin:/usr/local/bin:/usr/bin only, which misses operator tools
# in the home dir (pass-cli lives in ~/bin) — every resolve would exit 127.
# Keep this list covering every tool the auth records call — and ffmpeg
# (/usr/bin), which the transcription segment path shells out to.
Environment=PATH=/home/daniel/bin:/home/daniel/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/bun run src/index.ts
# SIGTERM rides the app's own graceful shutdown (fence lanes, drain intake).
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
