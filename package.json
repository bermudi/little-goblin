{
	"name": "goblin",
	"version": "0.2.0",
	"private": true,
	"description": "Telegram-native personal AI goblin. One operator, one Bun process.",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun --watch run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
		"app:build": "vite build app",
		"app:dev": "vite app",
		"doctor": "bun --no-install run src/doctor.ts",
		"try": "bun --no-env-file .agents/skills/verify-goblin/scripts/instance.ts"
	},
	"dependencies": {
		"@ai-sdk/openai": "4.0.118",
		"@ai-sdk/openai-compatible": "^3.0.92",
		"@ai-sdk/provider-utils": "5",
		"@anthropic-ai/claude-agent-sdk": "^0.3.325",
		"@earendil-works/chord": "1.5.2",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-codemode": "1.5.2",
		"@earendil-works/pi-durable": "1.5.2",
		"@earendil-works/pi-schema": "1.5.2",
		"@mozilla/readability": "^0.6.0",
		"@openrouter/ai-sdk-provider": "^3.1.0",
		"ai": "^7.0.173",
		"cron-parser": "^5.10.6",
		"grammy": "^1.46.0",
		"highlight.js": "^11.12.0",
		"json5": "^2.2.3",
		"linkedom": "^0.18.15",
		"mcporter": "0.17.0",
		"web-push": "4.0.0",
		"ws": "8.23.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/provider": "4.0.38",
		"@ai-sdk/react": "4.0.177",
		"@babel/parser": "8.1.2",
		"@milkdown/kit": "7.23.0",
		"@types/bun": "latest",
		"@types/json5": "^2.2.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/web-push": "3.6.4",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.3.0",
		"happy-dom": "^21.0.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^7.0.2",
		"vite": "8.3.8"
	},
	"engines": {
		"bun": ">=1.1.0"
	}
