# Template, not a unit — scripts/install.ts renders this to
# goblin-keys.service. Copied as-is it crash-loops: @WARM_AUTH_PROFILES@
# is unrendered. The .in suffix is the guard.
[Unit]
Description=Goblin keys — sync encrypted pass-keys profile snapshots
# Remote sync must not hold up foreground local reads. Retry until
# recovery; failed sync keeps last-good snapshots usable.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Same PATH as goblin.service — pass-keys and pass-cli resolve under
# THIS unit's env, not a login shell's.
Environment=PATH=/home/daniel/bin:/home/daniel/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin
# warm always refreshes from Pass. The installer renders one line per
# config-referenced auth record at @WARM_AUTH_PROFILES@; the MCP
# lane's profile is pinned here and by scripts/mcp. Profiles share
# agent/bootstrap and session, so sync stays sequential; snapshots
# stay separate. Locked/unavailable wallets fail loud.
@WARM_AUTH_PROFILES@
ExecStart=/home/daniel/.local/bin/pass-keys warm goblin-mcp-dev
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
