// Copy to ~/goblin/goblin.json5 (or $GOBLIN_HOME/goblin.json5) and fill in.
{
  // --- Telegram ---
  // BotFather token. Can be literal, env var name, or shell command.
  // botToken: "!pass show bots/goblin",  // get from password store
  // botToken: "BOT_TOKEN",               // read from env var
  botToken: "your-bot-token-here",

  // Telegram user IDs allowed to talk to the goblin. At least one required.
  // Find yours by DMing @userinfobot.
  allowedUsers: [123456789],

  // --- Model ---
  // MODEL uses prefixed IDs to pick provider. Set the matching API key.
  // Format: <provider>/<model-id>
  //
  // OpenRouter:
  //   or/anthropic/claude-sonnet-4.5, or/openai/gpt-5, ...
  //
  // Direct providers:
  //   openai/gpt-5.4, openai/gpt-5.4-mini, openai/o4
  //   anthropic/claude-opus-4, anthropic/claude-sonnet-4.6
  //   zai/glm-5.2, zai/glm-5.1  (Z.AI Coding Plan, Chat Completions)
  //   opencode-go/glm-5.2, opencode-go/minimax-m3, opencode-go/kimi-k2.6
  //   (OpenCode Go subscription — curated open coding models)
  model: "anthropic/claude-sonnet-4.6",

  // API keys. Set whichever your model needs. Values support env var names
  // and !commands just like botToken.
  // openrouterApiKey: "!pass-cli item view 'pass://Keys/OpenRouter/Api Key'",
  // openaiApiKey: "OPENAI_API_KEY",
  // anthropicApiKey: "ANTHROPIC_API_KEY",
  // zaiApiKey: "ZAI_API_KEY",
  // opencodeApiKey: "OPENCODE_API_KEY",

  // --- Favorite Models (for /model switching) ---
  // List model IDs you switch between often. Use /model to list and switch.
  favorites: [
    "openai/gpt-5.4",
    "anthropic/claude-sonnet-4.6",
    "zai/glm-5.2",
    "zai/glm-5.1",
    "opencode-go/glm-5.2",
    "opencode-go/minimax-m3",
    "opencode-go/kimi-k2.6",
    "opencode-go/kimi-k2.7-code",
  ],

  // --- Logging ---
  // debug | info | warn | error
  logLevel: "info",

  // --- UI ---
  // Tool-call visibility in the status line:
  //   none     no status line
  //   minimal  state-changing tools only (bash, write, edit, spawn_subagent)
  //   standard all α tools (default)
  //   verbose  α + γ tools (revive_subagent, list_subagents)
  //   debug    everything
  toolVisibility: "standard",

  // --- Voice ---
  // Microsoft Edge TTS voice for /voice and the text_to_speech tool.
  // Examples: en-US-EmmaMultilingualNeural, en-US-AndrewMultilingualNeural
  // Can be literal, env var name, or shell command. VOICE_NAME env overrides.
  // voiceName: "VOICE_NAME",
  // voiceName: "en-US-AndrewMultilingualNeural",

  // --- MCP (Model Context Protocol tools via mcporter) ---
  // Optional. Goblin wraps the `mcporter` CLI (invoked as `bunx mcporter`),
  // which owns server definitions, transports, and OAuth. Enable in two steps:
  //   1. Configure servers for the user running goblin, e.g.:
  //        bunx mcporter config add tavily https://mcp.tavily.com/mcp
  //      (writes ~/.mcporter/mcporter.json — or point mcp.configPath at a file)
  //   2. Add this block and restart:
  // mcp: {
  //   // Omit `enabled` to expose every server in the mcporter config.
  //   // enabled: ["tavily", "deepwiki"],
  //   // disabledServers: ["noisy-server"],  // deny-list; wins over `enabled`
  //   // configPath: "mcporter.json",        // relative paths resolve in $GOBLIN_HOME
  //   // defaultTimeoutMs: 120000,
  //   // maxResultChars: 16000,
  // },
  // Then `/mcp` in Telegram shows the live catalog; `/mcp refresh` re-scans.

  // --- Voice-note ASR (Groq Whisper) ---
  // Optional. When set, Telegram voice messages are transcribed and prompted
  // as a transcript turn (with the original file still saved for project-bound
  // sessions). Omit to leave voice intake unconfigured.
  // groqApiKey: "GROQ_API_KEY",
  // asrModel: "whisper-large-v3-turbo",  // or "whisper-large-v3"

  // --- Memory embeddings (hybrid semantic + FTS search) ---
  // Optional. Any OpenAI-compatible /v1/embeddings endpoint. All keys optional;
  // each falls back to its GOBLIN_MEMORY_EMBEDDING_* env var, then the client
  // default (api.openai.com + text-embedding-3-small). Omit the whole block to
  // run without semantic memory search. baseUrl has NO trailing /v1.
  // Values support env var names and !commands just like the keys above.
  // embeddings: {
  //   // apiKey: "!pass-cli item view 'pass://Keys/OpenRouter/Api Key'",
  //   // baseUrl: "https://openrouter.ai/api",
  //   // model: "perplexity/pplx-embed-v1-0.6b",
  //   // provider: "openrouter",  // label in memory_embeddings; model/provider change triggers reindex
  //   // cooldownSeconds: 60,
  // },
}
