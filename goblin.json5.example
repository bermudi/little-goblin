// Copy to $GOBLIN_HOME/goblin.json5 and fill in. No secrets here — those
// live in auth.jsonl. Editable at runtime via the Telegram mini app
// (chat menu button when publicUrl is set); hand-editing always works.
//
// auth.jsonl sits next to this file (mode 0600), one JSON record per line:
//   {"name": "telegram", "value": "123456:ABC-your-bot-token"}
//   {"name": "openrouter", "value": "!pass show api/openrouter"}
// A value starting with "!" is resolved by running it as a command at the
// point of use. Required records: "telegram" (the bot token) plus one per
// provider `auth` name below.
{
  // --- Provider registry: name → factory + auth.jsonl key ---
  providers: {
    // GLM via Z.AI coding plan — daily driver.
    zai: {
      kind: "openai-compatible",
      baseUrl: "https://api.z.ai/api/coding/paas/v4",
      auth: "zai", // resolves auth.jsonl record named "zai"
    },
    openrouter: {
      kind: "openrouter",
      auth: "openrouter",
    },
    // ChatGPT-subscription Codex models — auth comes from the codex CLI's
    // own OAuth file, not auth.jsonl. Run `codex login` first; expired
    // tokens are refreshed in-process and written back. authFile defaults
    // to ~/.codex/auth.json.
    // codex: { kind: "codex" },
  },

  // Default model: "<provider>/<model-id>". Model ids may contain slashes.
  // The zai coding plan only serves glm-5.3-gen — older glm-* ids are
  // silently routed to 5.3/5.3-flash, so write the real ones.
  model: "zai/glm-5.3-flash",
  // Auto-titles for Telegram's placeholder topic names ("New Chat"). Small
  // and cheap is the right shape — unset = topics keep the placeholder.
  // titleModel: "openrouter/openrouter/free",
  favorites: [
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "openrouter/anthropic/claude-sonnet-4.5",
  ],
  // Operator vocabulary — each model clamps it to its real ladder and the
  // mini app only offers levels the model can express (glm-5.3: low|high|
  // max — thinking is forced; gpt-6: low…xhigh|max; non-thinkers: off).
  thinking: "medium", // off | low | medium | high | xhigh | max

  // Text → Telegram voice notes (/voice mode, the speak tool, 🔊
  // buttons). ON BY DEFAULT — edge read-aloud needs no keys, just ffmpeg
  // on PATH (a failed boot probe disables it with a warning; install
  // ffmpeg and restart to re-enable). Uncomment to pick a different
  // voice/rate or alternates; `tts: ""` turns it off. Edge is
  // unofficial and may break.
  // tts: {
  //   kind: "edge",
  //   voice: "en-US-AriaNeural",
  //   rate: "+0%", // optional
  //   // The cast beyond `voice` — language follows the voice name, e.g.
  //   // ["es-MX-JorgeNeural"]. The speak tool picks per call; /voice
  //   // mode and the 🔊 button sniff each reply's language and cast the
  //   // matching voice, falling back to `voice` above.
  //   voices: [],
  // },

  // Speech → text for voice and video notes — transcribed once at
  // intake, and models that can't consume audio read the transcript
  // instead of a bare path. Also enables the transcribe tool so the
  // bot can transcribe attached audio/video files on request.
  // Unset = no transcription.
  // transcription: {
  //   kind: "groq",
  //   model: "whisper-large-v3-turbo", // default
  //   auth: "groq", // resolves auth.jsonl record named "groq"
  // },

  // --- Web access ---
  // Search provider(s) behind the `search` tool. Unset = no search tool.
  // One entry or an ordered list — the list is a fallback chain:
  // transport/HTTP/auth failures advance; empty results are an answer.
  // Kinds: brave | exa | jina | tavily | firecrawl | parallel | ddg
  // (jina/ddg work without a key; the rest need an auth.jsonl record).
  // search: { kind: "brave", auth: "brave" },
  // search: [{ kind: "brave", auth: "brave" }, { kind: "ddg" }],
  // Fetch/extract provider(s) behind the `fetch` tool. Unset = local
  // (direct HTTP + in-process readability — no key, handles plain HTML
  // and text; JS-heavy sites route through the browser skill).
  // Same list rule: [{ kind: "parallel", auth: "parallel" }, { kind: "local" }]
  // fetch: [{ kind: "parallel", auth: "parallel" }, { kind: "local" }],

  // --- Delegation (other coding harnesses, via herdr) ---
  // Unset = no delegate tool. Harnesses run in the `goblin` herdr
  // session (the goblin-herdr systemd unit), each in its own workspace;
  // results come back to the topic as a `[delegation: …]` message.
  // `kind` is a herdr agent kind (herdr agent → kind list); `args` are
  // native CLI args — full-auto flags and model choice live here, and
  // they must suppress startup dialogs (trust prompts report as idle).
  // Panes run your interactive shell, so aliases apply — never repeat a
  // flag an alias already adds (the codex alias's bypass flag, devin's
  // --permission-mode): a duplicate makes the harness refuse to start.
  // delegation: {
  //   session: "goblin", // default; must match the unit's --session
  //   maxRunning: 3,     // default
  //   harnesses: {
  //     codex: { kind: "codex" }, // the shell alias carries the bypass flag
  //     pi: { kind: "pi", args: ["--model", "<provider>/<model>"] },
  //   },
  // },

  // --- Gmail ---
  // Unset = no mail tool, no mail watcher. Your own Google Cloud OAuth
  // client (desktop-app flow, consent screen in production — a "testing"
  // app's refresh tokens die after 7 days). Two refresh tokens, two
  // scopes: read (gmail.readonly) and send (gmail.send). All three
  // secrets live in auth.jsonl (via pass-keys, like every other key);
  // access tokens are minted per use and never touch disk. Sending is
  // always operator-gated: the tool queues a draft and Telegram gets
  // Send/Cancel buttons — nothing sends on the model's word alone.
  // mail: {
  //   clientId: "xxx.apps.googleusercontent.com",
  //   clientSecretAuth: "gmail-client-secret",
  //   readAuth: "gmail-read",
  //   sendAuth: "gmail-send",
  // },

  // --- Telegram ---
  // Your user id (DM @userinfobot to find it). Only these users can talk.
  allowedUsers: [123456789],
  // Self-hosted telegram-bot-api in --local mode for large files.
  // Leave unset for the cloud API.
  // telegram: { apiRoot: "http://127.0.0.1:8081" },

  // --- Mini app ---
  // External HTTPS door (tailscale serve/funnel or any reverse proxy)
  // pointed at http://127.0.0.1:<http.port>. Unset = no menu button.
  // publicUrl: "https://goblin.your-tailnet.ts.net",
  http: { port: 8787 },

  logLevel: "info", // debug | info | warn | error
}
