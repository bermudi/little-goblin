[Unit]
Description=Goblin keys refresh — twice-daily sync of encrypted pass-keys snapshots
# Refresh is explicit background work, not snapshot expiry. Persistent
# catches missed runs; offline reads still require an unlocked wallet.

[Timer]
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 18:30:00
Persistent=true

[Install]
WantedBy=timers.target
