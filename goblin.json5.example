// Copy to $GOBLIN_HOME/goblin.json5 and fill in. No secrets here — those
// live in auth.jsonl. Editable at runtime via the Telegram mini app
// (chat menu button when publicUrl is set); hand-editing always works.
//
// auth.jsonl sits next to this file (mode 0600), one JSON record per line:
//   {"name": "telegram", "value": "123456:ABC-your-bot-token"}
//   {"name": "openrouter", "value": "!pass show api/openrouter"}
// A value starting with "!" is resolved by running it as a command at the
// point of use. Required records: "telegram" (the bot token) plus one per
// provider `auth` name below.
{
  // --- Provider registry: name → factory + auth.jsonl key ---
  providers: {
    // GLM via Z.AI coding plan — daily driver. The `responses` kind is
    // z.ai's OpenAI Responses door (https://api.z.ai/api/v1): the one
    // chat-family protocol whose tool outputs carry documents, so
    // fetched/sent PDFs reach the model natively (DESIGN.md, Web access).
    zai: {
      kind: "responses",
      baseUrl: "https://api.z.ai/api/v1",
      auth: "zai", // resolves auth.jsonl record named "zai"
    },
    openrouter: {
      kind: "openrouter",
      auth: "openrouter",
    },
    // ChatGPT-subscription Codex models — auth comes from the codex CLI's
    // own OAuth file, not auth.jsonl. Run `codex login` first; expired
    // tokens are refreshed in-process and written back. authFile defaults
    // to ~/.codex/auth.json.
    // codex: { kind: "codex" },
  },

  // Default model: "<provider>/<model-id>". Model ids may contain slashes.
  // The zai coding plan only serves glm-5.3-gen — older glm-* ids are
  // silently routed to 5.3/5.3-flash, so write the real ones.
  model: "zai/glm-5.3-flash",
  // Auto-titles for Telegram's placeholder topic names ("New Chat"). Small
  // and cheap is the right shape — unset = topics keep the placeholder.
  // titleModel: "openrouter/openrouter/free",
  favorites: [
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "openrouter/anthropic/claude-sonnet-4.5",
  ],
  // Operator vocabulary — each model clamps it to its real ladder and the
  // mini app only offers levels the model can express (glm-5.3: low|high|
  // max — thinking is forced; gpt-6: low…xhigh|max; non-thinkers: off).
  thinking: "medium", // off | low | medium | high | xhigh | max

  // Text → Telegram voice notes (/voice mode, the speak tool, 🔊
  // buttons). ON BY DEFAULT — edge read-aloud needs no keys, just ffmpeg
  // on PATH (a failed boot probe disables it with a warning; install
  // ffmpeg and restart to re-enable). Uncomment to pick a different
  // voice/rate or alternates; `tts: ""` turns it off. Edge is
  // unofficial and may break.
  // tts: {
  //   kind: "edge",
  //   voice: "en-US-AriaNeural",
  //   rate: "+0%", // optional
  //   // The cast beyond `voice` — language follows the voice name, e.g.
  //   // ["es-MX-JorgeNeural"]. The speak tool picks per call; /voice
  //   // mode and the 🔊 button sniff each reply's language and cast the
  //   // matching voice, falling back to `voice` above.
  //   voices: [],
  // },

  // Speech → text for voice and video notes — transcribed once at
  // intake, and models that can't consume audio read the transcript
  // instead of a bare path. Also enables the transcribe tool so the
  // bot can transcribe attached audio/video files on request.
  // Unset = no transcription.
  // transcription: {
  //   kind: "groq",
  //   model: "whisper-large-v3-turbo", // default
  //   auth: "groq", // resolves auth.jsonl record named "groq"
  // },

  // --- Vision (image Q&A) ---
  // Unset = no vision tool. With it, the bot can ask a vision model
  // targeted questions about image files on disk (screenshots,
  // downloaded images, ffmpeg-extracted frames) — the only way it can
  // see an image's content, since read_file refuses images. `model` is
  // any "<provider>/<model-id>" ref from `providers` above (auth rides
  // the provider's own auth.jsonl ref). followUp=true continues the
  // previous thread about the same image.
  // vision: {
  //   model: "openrouter/google/gemini-2.5-flash",
  //   maxTokens: 2000, // default
  //   // "auto" (default) registers the tool only while the chat model
  //   // can't consume images; "always" keeps it for vision-capable
  //   // models too — a file on disk is invisible to either.
  //   mode: "auto",
  // },

  // --- Web access ---
  // Search provider(s) behind the `search` tool. Unset = no search tool.
  // One entry or an ordered list — the list is a fallback chain:
  // transport/HTTP/auth failures advance; empty results are an answer.
  // Kinds: brave | exa | jina | tavily | firecrawl | parallel | ddg
  // (jina/ddg work without a key; the rest need an auth.jsonl record).
  // search: { kind: "brave", auth: "brave" },
  // search: [{ kind: "brave", auth: "brave" }, { kind: "ddg" }],
  // Fetch/extract provider(s) behind the `fetch` tool. Unset = local
  // (direct HTTP + in-process readability — no key, handles plain HTML
  // and text; JS-heavy sites route through the browser skill).
  // Same list rule: [{ kind: "parallel", auth: "parallel" }, { kind: "local" }]
  // fetch: [{ kind: "parallel", auth: "parallel" }, { kind: "local" }],

  // --- Skill reviewer ---
  // Unset = automatic skill saving off. `auth` names the auth.jsonl
  // record holding your OpenRouter key (the Jev gate rides it).
  // threshold is the gate's shared yes-cutoff; thresholds overrides it
  // per question. queueCap bounds queued reviews (a full queue drops
  // the incoming). evidence bounds the tool-call digest the review
  // sees (last N calls, truncated arguments and results).
  // reviewer: {
  //   auth: "openrouter",
  //   threshold: 0.8,
  //   thresholds: { correction: 0.8, procedure: 0.85 },
  //   queueCap: 3,
  //   evidence: { calls: 8, argChars: 300, outChars: 300 },
  //   // model: "provider/model", // default: the conversation's own
  // },

  // --- System One (the small gate model) ---
  // One block feeding the reviewer's Jev gate, mail-event scoring, and
  // the loopback injection check. Unset = those consumers fall back to
  // reviewer.auth and built-in defaults. `model` is a Jev model id
  // (e.g. respan/span-01-lite), NOT a <provider>/<model> chat ref.
  // system1: { auth: "openrouter" },

  // --- Delegation (other coding harnesses, via herdr) ---
  // Unset = no delegate tool. Harnesses run in goblin's OWN LOCAL
  // herdr session (the goblin-herdr systemd unit's --session goblin
  // — the name lives in the unit, not here), each in its own
  // workspace. Results come back to the topic as a
  // `[delegation: …]` message. `kind` is a herdr agent kind
  // (herdr agent → kind list); `args` are native CLI args —
  // full-auto flags and model choice live here.
  // `machines` adds other targets for work that belongs on another
  // host: `machine` names a herdr saved-machine profile (the ssh
  // target and pinned remote session live in herdr:
  // `herdr machine add <host> --remote-session goblin`), `session`
  // alone is another local session, `root` resolves that target's
  // relative cwds and reports (absolute or ~/…), and optional
  // `harnesses` declares what runs there — harness availability is
  // a property of the host. delegate start takes `on: <label>`;
  // omitted = own local session. First-run trust dialogs are seeded
  // silently on every host (locally at launch, remotely through the
  // delegation's own pane); a gate that still appears parks
  // `needs_input` — relay it and press the operator's key via
  // `delegate answer`.
  // Panes run your interactive shell, so aliases apply — never repeat a
  // flag an alias already adds (the codex alias's bypass flag, devin's
  // --permission-mode): a duplicate makes the harness refuse to start.
  // delegation: {
  //   harnesses: {
  //     codex: { kind: "codex" }, // the shell alias carries the bypass flag
  //     pi: { kind: "pi", args: ["--model", "<provider>/<model>"] },
  //   },
  //   machines: {
  //     // lithium: { session: "goblin" },
  //     // g7: { machine: "g7", root: "~/build",
  //     //       harnesses: { devin: { kind: "devin" } } },
  //   },
  // },

  // --- Gmail ---
  // Unset = no mail tool, no mail watcher. Reads ride the gws CLI
  // (`gws auth login` with the Workspace scopes in the gws skill —
  // gmail.readonly, drive.readonly, calendar + sheets read-write).
  // Your own Google Cloud OAuth client (desktop-app flow, consent
  // screen in production — a "testing" app's refresh tokens die after
  // 7 days) covers only the SEND: the client secret and the send
  // refresh token live in auth.jsonl (via pass-keys, like every other
  // key); access tokens are minted per send and never touch disk.
  // Sending is always operator-gated: the tool queues a draft and
  // Telegram gets Send/Cancel buttons — nothing sends on the model's
  // word alone.
  // mail: {
  //   clientId: "xxx.apps.googleusercontent.com",
  //   clientSecretAuth: "gmail-client-secret",
  //   sendAuth: "gmail-send",
  // },

  // --- Long-term memory (Hindsight) ---
  // Unset = no retention and no recall — nothing is remembered between
  // conversations. The service runs separately (docs/memory.md,
  // deploy/memory/); bankId names your memory bank. `auth` names an
  // auth.jsonl record only when the service isn't loopback. The bounds
  // keep recall from stalling a turn. Boot-pinned: changing the block
  // mid-run needs a restart.
  // memory: {
  //   baseUrl: "http://127.0.0.1:8888",
  //   bankId: "goblin",
  //   // auth: "hindsight",         // bearer — only when off loopback
  //   // budget: "low",             // low | mid | high — retention effort
  //   // maxTokens: 1024,           // recall injection cap
  //   // recallTimeoutMs: 5000,
  // },

  // --- Telegram ---
  // Your user id (DM @userinfobot to find it). Only these users can talk.
  allowedUsers: [123456789],
  // Self-hosted telegram-bot-api in --local mode for large files.
  // Leave unset for the cloud API. dmGapMinutes is the quiet gap before
  // a DM may roll into a new conversation (Rolling DM) — it applies
  // immediately and is also settable in the settings app.
  // telegram: { apiRoot: "http://127.0.0.1:8081", dmGapMinutes: 45 },

  // --- Mini app + app channel ---
  // External HTTPS door (tailscale serve/funnel or any reverse proxy)
  // pointed at http://127.0.0.1:<http.port>. Unset = no menu button.
  // publicUrl: "https://goblin.your-tailnet.ts.net",
  http: { port: 8787 },
  // The app channel (/app/, the React client) shares this door.
  // `appToken` names an auth.jsonl record whose value is the bearer
  // token /api/app/* demands. Unset = trust mode — the tailnet is the
  // only lock; NEVER put trust mode behind a public URL (funnel).
  // Boot-pinned: a mid-run change applies on restart.
  // appToken: "app",

  logLevel: "info", // debug | info | warn | error
}
