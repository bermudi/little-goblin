[Unit]
Description=Optional Goblin Hindsight API
Requires=goblin-memory-db.service
After=goblin-memory-db.service

[Container]
# API-only slim 1.0.0: no bundled local embedding/reranking models.
Image=ghcr.io/vectorize-io/hindsight-api:1.0.0-slim@sha256:1e889b5f44a3546a40765d084162cf0807c0b08c97fb29f64d0705597f1ef3b6
ContainerName=goblin-memory-api
Pod=goblin-memory.pod
# Non-secret configuration only. Credentials never land in this file or
# the env file: each arrives as a podman shell-secret MOUNT under
# /run/secrets (tmpfs inside the container; podman stores the lookup
# command, never the value), and start.py exports each file under its
# own name. The LLM key is required by every profile. The installer
# writes provider-scoped secret lines between the markers — keep them.
Secret=HINDSIGHT_API_LLM_API_KEY,type=mount
# goblin:secrets-begin
# goblin:secrets-end
EnvironmentFile=%h/.config/goblin-memory/hindsight.env
Volume=%h/.config/goblin-memory/start.py:/opt/goblin-memory-start.py:ro,Z
# The healthcheck is a mounted script, not a `python -c` one-liner:
# podman 5.4 (Debian trixie) drops the trailing escaped quote when
# re-quoting HealthCmd into CMD-SHELL, causing
# `sh: Unterminated quoted string` instead of a readiness result.
# A bare command with no shell
# metacharacters survives every podman/systemd pair.
Volume=%h/.config/goblin-memory/healthcheck.py:/opt/goblin-memory-healthcheck.py:ro,Z
Exec=/app/api/.venv/bin/python /opt/goblin-memory-start.py
HealthCmd=/app/api/.venv/bin/python /opt/goblin-memory-healthcheck.py
HealthInterval=15s
HealthTimeout=10s
HealthRetries=4
HealthStartPeriod=60s
Notify=healthy
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

# Enabled at boot like goblin.service itself. The installer's cost
# confirmation gates the FIRST start only — a reboot must not silently
# strand a memory-enabled goblin against a dead endpoint (the original
# "operator starts it explicitly" ruling died the first nightly
# shutdown: the stack stayed down for days while the bot retried).
[Install]
WantedBy=default.target
