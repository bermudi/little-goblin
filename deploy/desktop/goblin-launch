#!/bin/sh
# goblin-launch <app> — start a whitelisted app on the desktop,
# detached so the exec that launched it can return. The env written by
# goblin-desktop-session carries DISPLAY, the session bus and the
# desktop user.
set -eu

set -a; . /run/desk/env; set +a
DESK_HOME="/home/${DESK_USER}"

run_detached() {
	if [ "$(id -un)" = "${DESK_USER}" ]; then
		"$@" </dev/null >/dev/null 2>&1 &
	else
		setpriv --reuid="${DESK_USER}" --regid="${DESK_USER}" --clear-groups \
			--reset-env \
			env DISPLAY="${DISPLAY}" \
				DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS}" \
				HOME="${DESK_HOME}" XDG_RUNTIME_DIR="${DESK_HOME}/.runtime" "$@" \
			</dev/null >/dev/null 2>&1 &
	fi
}

case "${1:-}" in
	chromium)
		# --no-sandbox: the zygote needs CAP_SYS_CHROOT to bring up the
		# layer-1 sandbox and the wall grants only the five sandbox caps
		# ("Failed to receive hello message from zygote"). The session
		# still runs as desk, so the browser is an unprivileged uid
		# inside the container's own wall.
		#
		# $2 is a model-controlled URL landing on Chromium's argv: only
		# a real URL or about:blank, never a bare --flag. desktops.ts
		# refuses earlier; this guard is the in-image backstop.
		url="${2:-}"
		if [ -n "${url}" ]; then
			case "${url}" in
				http://*|https://*|file://*|about:blank) ;;
				*)
					echo "goblin-launch: refused url '${url}'" >&2
					exit 64
					;;
			esac
			case "${url}" in
				*[[:space:]]*|*[[:cntrl:]]*)
					echo "goblin-launch: refused url '${url}'" >&2
					exit 64
					;;
			esac
		fi
		run_detached chromium --no-sandbox --force-renderer-accessibility \
			${url:+"${url}"}
		;;
	*)
		echo "goblin-launch: unknown app '${1:-}' (whitelist: chromium)" >&2
		exit 64
		;;
esac
